{
  "name": "stateful-agent",
  "displayName": "Stateful Agent",
  "description": "会話履歴の代わりに構造化 state を持ち、規律を宣言的に実行するエージェント",
  "version": "0.1.0",
  "private": true,
  "publisher": "local",
  "engines": {
    "vscode": "^1.94.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "statefulAgent.open",
        "title": "Stateful Agent: 開く"
      },
      {
        "command": "statefulAgent.openCenter",
        "title": "Stateful Agent: センターで開く"
      },
      {
        "command": "statefulAgent.setMode",
        "title": "Stateful Agent: 履歴モードを切り替え"
      },
      {
        "command": "statefulAgent.resetState",
        "title": "Stateful Agent: state をリセット"
      },
      {
        "command": "statefulAgent.showMetrics",
        "title": "Stateful Agent: 実測ログを集計"
      },
      {
        "command": "statefulAgent.openGraph",
        "title": "Stateful Agent: state グラフを開く"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "statefulAgent",
          "title": "Stateful Agent",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "statefulAgent": [
        {
          "id": "statefulAgent.graph",
          "name": "state グラフ",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Stateful Agent",
      "properties": {
        "statefulAgent.historyMode": {
          "type": "string",
          "enum": [
            "stateless",
            "recent",
            "full"
          ],
          "default": "recent",
          "description": "stateless=stateのみ / recent=state+直近Nターン / full=通常の履歴"
        },
        "statefulAgent.recentTurns": {
          "type": "number",
          "default": 3,
          "description": "recent モードで保持するターン数"
        },
        "statefulAgent.statePath": {
          "type": "string",
          "default": ".ctx/state/current.json",
          "description": "state ファイルのワークスペース相対パス"
        },
        "statefulAgent.rulesDir": {
          "type": "string",
          "default": ".agent/rules",
          "description": "規律 YAML の置き場所"
        },
        "statefulAgent.manifestPath": {
          "type": "string",
          "default": "",
          "description": "フォルダ→OKF type 対応表(manifest)のパス。空なら .agent/manifest.yaml → vault設計/manifest.yaml の順に自動探索する"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "check": "npm run typecheck && npm test",
    "bench": "node dist/bench.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.266",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.94.0",
    "autoprefixer": "^10.5.5",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
