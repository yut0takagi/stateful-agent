{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "拡張を起動（空のウィンドウ）",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--new-window",
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "build"
    },
    {
      "name": "拡張を起動（vault のコピーを開く）",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--new-window",
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--folder-uri=file://${workspaceFolder}/../.."
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "build"
    }
  ]
}
